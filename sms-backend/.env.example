# Configuration backend SMS (aucune vraie valeur ici)
# Copier ce fichier vers .env et remplir les valeurs

# Hôte MySQL (localhost en dev, endpoint public Aiven en production)
DB_HOST=
# Port MySQL (défaut : 3306)
DB_PORT=
# Utilisateur MySQL
DB_USER=
# Mot de passe MySQL
DB_PASSWORD=
# Nom de la base MySQL
DB_NAME=
# Secret de signature des JWT (obligatoire, à régénérer avant production)
JWT_SECRET=